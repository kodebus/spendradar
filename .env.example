# Plaid (get PLAID_CLIENT_ID and PLAID_SECRET from https://dashboard.plaid.com/team/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake test banks, works immediately) | development | production (real Capital One, needs Plaid approval)
PLAID_ENV=sandbox

# A password of your own choosing. Whoever visits your deployed URL needs this
# (entered in the app's Settings panel) before they can hit the bank-connect API.
APP_SECRET=

# Auto-filled by Vercel when you attach a KV (Upstash Redis) store to this project
# in the Vercel dashboard under Storage — you shouldn't need to set these by hand.
KV_REST_API_URL=
KV_REST_API_TOKEN=
